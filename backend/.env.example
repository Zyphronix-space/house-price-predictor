# Copy to backend/.env for local development. Never commit real values.
# In production these are set as encrypted Vercel environment variables.

# SQLAlchemy URL. Local default is a SQLite file next to the app.
DATABASE_URL=sqlite:///./house_price.db

# Required in any deployed environment (the app refuses to start on Vercel
# without it). Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-value

# Optional: enables the "describe your property" text parser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Local development only. When true, /auth/forgot-password returns the reset
# token in the response, which lets anyone reset any account. Keep unset in
# production.
PASSWORD_RESET_DEMO_MODE=
